# Reference copy of the backend configuration.
# Copy backend/.env.example to backend/.env and set the values there.

# ElevenLabs account key with speech_to_text and text_to_speech permissions.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID selected from the voices available to your ElevenLabs account.
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Google AI Studio API key with access to the configured Gemini model.
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Optional Gemini model override. Must be available to your Google API key.
GOOGLE_MODEL=gemini-3.5-flash-lite

# SQLite database path, relative to the backend working directory by default.
DATABASE_PATH=./doctor_appointments.db
