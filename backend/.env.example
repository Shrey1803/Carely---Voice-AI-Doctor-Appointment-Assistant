# Carely voice appointment assistant backend configuration.
# Copy this file to .env in the backend directory and fill in your own values.

# ElevenLabs API key. The voice pipeline needs speech_to_text and text_to_speech access.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID for Ava, selected from the voices available to your ElevenLabs account.
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Google AI Studio API key with access to the selected Gemini model.
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Optional Gemini model override. Must be enabled for your Google API key.
GOOGLE_MODEL=gemini-3.5-flash-lite

# SQLite database location; relative paths resolve from the backend working directory.
DATABASE_PATH=./doctor_appointments.db
